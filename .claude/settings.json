{
  "hooks": {
    "SessionStart": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "\"$CLAUDE_PROJECT_DIR/.claude/hooks/session-start.sh\""
          }
        ]
      }
    ]
  },
  "permissions": {
    "allow": [
      "Bash(git fetch origin main)",
      "Bash(git status --short)",
      "Bash(git worktree list)",
      "Bash(python3 scripts/worktree_setup.py:*)"
    ]
  }
}
